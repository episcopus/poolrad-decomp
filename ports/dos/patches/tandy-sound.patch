+        jmp TandyQuiet
+TandyTune:
+        cmp word ptr [ScriptPtr], 0         ; port: a designed tune plays its script, not its voices
+        je TandyVoicesStep
+        jmp ScriptStep
+TandyVoicesStep:
         mov byte ptr [VoicesLeft], 4
         mov si, TandyNotes
         mov word ptr [NoteTable], si
@@ -1931,10 +1937,20 @@
         shr al, 1
         shr al, 1
         xor al, dl
+        cmp dl, 0E0h
+        je TandyNoise
         out 0C0h, al
-        cmp dl, 0E0h
+        mov al, ah
+        out 0C0h, al
+        jmp short L1546
+
+; port: the noise control only when it changes (every write of it resets the chip's shift register)
+TandyNoise:
+        mov ah, al
+        and ah, 7
+        cmp ah, byte ptr [LastNoise]
         je L1546
-        mov al, ah
+        mov byte ptr [LastNoise], ah
         out 0C0h, al
 L1546:
         mov ax, 0FFFFh
@@ -1963,6 +1979,43 @@
         out 0C0h, al
         mov al, 0FFh
         out 0C0h, al
+        ret
+
+; port: ScriptStep, a frame of the current tune's script every second tick (ports/dos/sound/port.py). Uses ax and
+; si only (the handler saves ax, bx, dx, ds, si).
+ScriptStep:
+        cmp byte ptr [OutputOn], 0
+        je TandyQuiet
+        mov al, byte ptr [ScriptPhase]
+        xor byte ptr [ScriptPhase], 1
+        cmp al, 0
+        jne ScriptDone
+        cmp byte ptr [ScriptWait], 0
+        je ScriptFrame
+        dec byte ptr [ScriptWait]
+        ret
+ScriptFrame:
+        mov si, word ptr [ScriptPtr]
+        mov al, byte ptr [si]
+        cmp al, 0FEh
+        je TandyQuiet
+        inc si
+        cmp al, 80h
+        jb ScriptWrites
+        sub al, 80h
+        mov byte ptr [ScriptWait], al
+        mov word ptr [ScriptPtr], si
+        ret
+ScriptWrites:
+        mov ah, al
+ScriptOut:
+        mov al, byte ptr [si]
+        inc si
+        out 0C0h, al
+        dec ah
+        jne ScriptOut
+        mov word ptr [ScriptPtr], si
+ScriptDone:
         ret
 
