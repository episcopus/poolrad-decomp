+@WordRow:
+  mov   cx, RowBytes
+  shr   cx, 1
+  jcxz  @WordNext
+  mov   di, DestRow
+  add   di, RowBytes
+  dec   di
+  dec   di                     { the row's last word in Dest }
+@Word:
+  lodsw                        { AL the byte at 2K, AH at 2K + 1 }
