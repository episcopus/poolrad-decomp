+  xlat
+  xchg  al, ah
+  segcs
+  xlat                         { AL: swapped 2K + 1, AH: swapped 2K }
+  mov   es:[di], ax            { Dest bytes RowBytes - 2 - 2K and RowBytes - 1 - 2K }
+  dec   di
+  dec   di
+  loop  @Word
+@WordNext:
+  mov   ax, DestRow
+  add   ax, RowBytes
+  mov   DestRow, ax
+  dec   dx
+  jnz   @WordRow
+@WordsDone:
+  pop   ds
+  jmp   @Out
+@Bytes:
