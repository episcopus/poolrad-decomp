 procedure TandyMirrorRows(Source, Dest: Pointer; Rows, RowBytes: Word); assembler;
+{ ports/dos speed patch (mirror-xlat): when Source and Dest do not overlap and the rows are whole words (MirrorPicture's
+  rows are WidthCols * 4 bytes), each row is read forward a word at a time and written backward, the nibbles swapped
+  through NibbleSwapTable: the bytes written are the byte loop's, and with no overlap the order they are written in
+  cannot matter. Otherwise (a picture mirrored onto itself) the byte loop below, unchanged. }
+var
+  DestRow: Word;
 asm
   cld                          { (the game does not always leave the direction flag clear) }
+  mov   ax, Rows
+  mul   RowBytes
+  mov   cx, ax
+  mov   bx, dx                 { BX:CX the bytes of each buffer }
+  test  RowBytes, 1
+  jnz   @Bytes
+  { the linear address of Source in DX:AX, of Dest in DI:SI }
+  mov   ax, word ptr Source+2
+  mov   dx, ax
+  shl   ax, 1
+  shl   ax, 1
+  shl   ax, 1
+  shl   ax, 1
+  shr   dx, 1
+  shr   dx, 1
+  shr   dx, 1
+  shr   dx, 1
+  shr   dx, 1
+  shr   dx, 1
+  shr   dx, 1
+  shr   dx, 1
+  shr   dx, 1
+  shr   dx, 1
+  shr   dx, 1
+  shr   dx, 1
+  add   ax, word ptr Source
+  adc   dx, 0
+  mov   si, word ptr Dest+2
+  mov   di, si
+  shl   si, 1
+  shl   si, 1
+  shl   si, 1
+  shl   si, 1
+  push  cx
+  mov   cl, 12
+  shr   di, cl
+  pop   cx
+  add   si, word ptr Dest
+  adc   di, 0
+  { disjoint when Source + size <= Dest or Dest + size <= Source }
+  push  ax
+  push  dx
+  add   ax, cx
+  adc   dx, bx                 { Source + size }
+  cmp   dx, di
+  jb    @Disjoint2
+  ja    @Check2
+  cmp   ax, si
+  jbe   @Disjoint2
+@Check2:
+  pop   dx
+  pop   ax
+  add   si, cx
+  adc   di, bx                 { Dest + size }
+  cmp   di, dx
+  jb    @Words
+  ja    @Bytes
+  cmp   si, ax
+  jbe   @Words
+  jmp   @Bytes
+@Disjoint2:
+  pop   dx
+  pop   ax
+@Words:
+  push  ds
+  lds   si, Source
+  les   di, Dest
+  mov   bx, offset NibbleSwapTable
+  mov   dx, Rows
+  or    dx, dx
