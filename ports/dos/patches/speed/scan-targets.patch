+  xor   si, si
+@Cand:
+  mov   byte ptr CandX[si], -1
+  mov   bl, Base
+  or    bl, bl
+  jz    @CandNext              { FootprintCell: kind 0 is False }
+  xor   bh, bh
+  shl   bx, 1
+  shl   bx, 1
+  shl   bx, 1
+  add   bx, si
+  add   bx, si                 { Kind * 8 + Index * 2 }
+  mov   ax, word ptr Footprints[bx]
+  or    al, al
+  js    @CandNext              { DX < 0: False }
