+  jg    @KOff
+  mov   al, byte ptr TargY[si]
+  or    al, al
+  js    @KOff
+  cmp   al, 24
+  jle   @KOnMap
+@KOff:
+  jmp   @KNext
+@KOnMap:
+  xor   di, di                 { J }
+@J:
+  mov   al, byte ptr CandX[di]
+  or    al, al
+  jns   @JValid
+  jmp   @JNext
+@JValid:
+  cmp   Omni, 0
+  jne   @Reach                 { InDirArc with Dir 8: both points are on the map (checked above) }
+@CallArc:
+  push  si
+  push  di
+  mov   al, byte ptr CandX[di]
+  push  ax
+  mov   al, byte ptr CandY[di]
+  push  ax
+  mov   al, byte ptr TargX[si]
+  push  ax
+  mov   al, byte ptr TargY[si]
+  push  ax
+  mov   al, Dir
+  push  ax
+  call  InDirArc
+  pop   di
+  pop   si
+  or    al, al
+  jz    @JNext
+@Reach:
+  { 2 * max + min of |TargX - CandX| and |TargY - CandY| against Limit: past it WalkLine fails }
+  mov   al, byte ptr TargX[si]
+  sub   al, byte ptr CandX[di]
+  cbw
+  or    ax, ax
+  jns   @AbsX
+  neg   ax
+@AbsX:
+  mov   bx, ax
+  mov   al, byte ptr TargY[si]
+  sub   al, byte ptr CandY[di]
+  cbw
+  or    ax, ax
+  jns   @AbsY
+  neg   ax
+@AbsY:
+  cmp   ax, bx
+  jbe   @Ordered
+  xchg  ax, bx                 { BX the larger }
+@Ordered:
+  shl   bx, 1
+  add   ax, bx
+  cmp   ax, Limit
+  ja    @JNext
+  mov   al, byte ptr TargX[si]
+  mov   Ex, al
+  mov   al, byte ptr TargY[si]
+  mov   Ey, al
+  mov   ax, MaxSteps
+  mov   StepCount, ax
+  push  si
+  push  di
+  mov   al, byte ptr CandX[di]
+  push  ax
+  mov   al, byte ptr CandY[di]
+  push  ax
+  push  ss
+  lea   ax, Ex
+  push  ax
+  push  ss
+  lea   ax, Ey
+  push  ax
+  push  ss
+  lea   ax, StepCount
+  push  ax
+  push  word ptr Map[2]
+  push  word ptr Map
+  call  WalkLine
+  pop   di
+  pop   si
+  or    al, al
+  jz    @JNext
+  mov   Found, 1
+  mov   ax, StepCount
+  cmp   ax, Best
+  jae   @JNext
+  mov   Best, ax
+  mov   ax, di
+  mov   BestJ, al
+  mov   ax, si
+  mov   BestK, al
+@JNext:
+  inc   di
+  cmp   di, 4
+  jae   @KNext
+  jmp   @J
+@KNext:
+  inc   si
+  cmp   si, 4
+  jae   @Pairs
+  jmp   @K
+@Pairs:
+  cmp   Found, 0
