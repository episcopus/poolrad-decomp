+  cmp   si, 4
+  jb    @Targ
+  xor   si, si                 { K }
+@K:
+  mov   al, byte ptr TargX[si]
+  or    al, al
+  jns   @KValid
+  jmp   @KNext
+@KValid:
+  cmp   Omni, 0
+  je    @KOnMap
