+asm
+  mov   ax, MaxSteps
+  shl   ax, 1
+  inc   ax
+  mov   Limit, ax              { WalkLine's Limit, the same Word arithmetic }
+  mov   Omni, 0
+  mov   al, Dir
+  cmp   al, 8
