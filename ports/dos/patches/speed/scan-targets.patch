+  cmp   al, 49
+  jg    @CandOff
+  or    ah, ah
+  js    @CandOff
+  cmp   ah, 24
+  jle   @CandNext
+@CandOff:
+  mov   byte ptr CandX[si], -1
+@CandNext:
