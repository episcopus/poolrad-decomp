+  cmp   si, 4
+  jb    @Cand
+  mov   byte ptr SortEntries[2], 0   { SortEntries[0].Val := 0 }
+  mov   al, byte ptr CombatantTable[3]
+  mov   Count, al              { the for loop's limit, read once }
+  or    al, al
+  jnz   @First
+  jmp   @Sort
+@First:
+  mov   I, 1
+@Entry:
+  mov   bl, I
+  xor   bh, bh
+  shl   bx, 1
+  shl   bx, 1                  { I * 4 }
+  mov   al, byte ptr CombatantTable[bx+3]
+  or    al, al
+  jnz   @Live
+  jmp   @NextEntry             { Kind 0: not on the map }
+@Live:
+  mov   Found, 0
+  mov   Best, $FF
+  mov   dx, word ptr CombatantTable[bx]   { DL = X, DH = Y }
+  xor   ah, ah
+  shl   ax, 1
+  shl   ax, 1
+  shl   ax, 1
+  mov   cx, ax                 { Kind * 8 }
+  xor   si, si
+@Targ:
