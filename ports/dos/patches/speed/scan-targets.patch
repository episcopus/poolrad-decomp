+  jl    @DirN0
+  mov   L2, 1
+  jmp   @StoreDir
+@DirN0:
+  neg   ax                     { -A }
+  cmp   cx, ax
+  jle   @DirN7
+  mov   L2, 0
+  jmp   @StoreDir
+@DirN7:
+  jl    @DirN6
+  mov   L2, 7
+  jmp   @StoreDir
+@DirN6:
+  mov   L2, 6
+  jmp   @StoreDir
+@DirRow:
+  or    cx, cx
+  jz    @StoreDir              { 0 }
+  mov   L2, 2
+  jg    @StoreDir
+  mov   L2, 6
+  jmp   @StoreDir
+@DirSouth:
+  cmp   cx, ax
+  jle   @DirS3
+  mov   L2, 2
+  jmp   @StoreDir
+@DirS3:
+  cmp   cx, 1
+  jl    @DirS4
+  mov   L2, 3
+  jmp   @StoreDir
+@DirS4:
+  neg   ax
+  cmp   cx, ax
+  jle   @DirS5
+  mov   L2, 4
+  jmp   @StoreDir
+@DirS5:
+  mov   L2, 5
+  jmp   @StoreDir
+@FindDir:
+  push  bx
+  mov   bl, BestJ
+  xor   bh, bh
+  mov   di, bx
+  mov   bl, BestK
+  mov   si, bx
+  mov   al, byte ptr CandX[di]
+  push  ax
+  mov   al, byte ptr CandY[di]
+  push  ax
+  mov   al, byte ptr TargX[si]
+  push  ax
+  mov   al, byte ptr TargY[si]
+  push  ax
+  mov   al, L2
+  push  ax
+  call  InDirArc
+  pop   bx
+  or    al, al
+  jnz   @StoreDir
