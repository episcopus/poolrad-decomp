--- a/RES07.PAS
+++ b/RES07.PAS
@@ -399,6 +399,48 @@
   xor   al, al                 { the ShortInt limit is below 1: no byte }
 @Counted:
   mov   Count, ax
+  { ports/dos speed patch (masked-rows): the same tracker values in a register loop. Row R's first changed byte is
+    DestOfs + LeftCol + R * (LeftCol + Count + RightRoom) and its last Count - 1 further on, all modulo 64 KB as the
+    loop below adds them; the dirty flags are set first by one REP STOSB (other bytes than the offsets). }
+  mov   cx, Rows
+  jcxz  @OldTrack              { (the loop below would run 65536 times: keep its exact behaviour) }
+  push  es
+  push  ds
+  pop   es
+  mov   di, offset RowDirtyFlags
+  add   di, FirstRow
+  mov   al, 1
+  rep   stosb
+  pop   es
+  mov   bx, FirstRow
+  shl   bx, 1
+  mov   cx, Rows
+  mov   dx, LeftBytes
+  mov   si, Count
+  dec   si                     { from a row's first byte to its last }
+  mov   di, LeftCol
+  add   di, Count
+  add   di, RightRoom          { from one row's first byte to the next's }
+  mov   ax, DestOfs
+  add   ax, LeftCol
+@FastTrack:
+  cmp   ax, word ptr RowFirstChangedOfs[bx]
+  jae   @FastFirst
+  mov   word ptr RowFirstChangedCol[bx], dx
+  mov   word ptr RowFirstChangedOfs[bx], ax
+@FastFirst:
+  add   ax, si
+  cmp   ax, word ptr RowLastChangedOfs[bx]
+  jbe   @FastLast
+  mov   word ptr RowLastChangedOfs[bx], ax
+@FastLast:
+  sub   ax, si
+  add   ax, di
+  inc   bx
+  inc   bx
+  loop  @FastTrack
+  jmp   @Tracked
+@OldTrack:
   { the trackers, row by row as the Pascal: AX is DestOfs }
   mov   si, FirstRow
   mov   bx, si
@@ -426,6 +468,7 @@
   inc   bx
