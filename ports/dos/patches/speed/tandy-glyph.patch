+{ ports/dos speed patch (tandy-glyph): DrawGlyph's Tandy branch in the built-in assembler, for one
+  glyph. The glyph's 8 font rows go to the 8 scanlines of text row Row (scanline y is in bank y mod 4,
+  $2000 bytes apart, 160 bytes per line), 4 bytes per row at byte column Col * 4; each byte holds two
+  pixels, the font bit $80 of a pair the high nibble: Color where the bit is set, 0 where it is clear.
+  The Pascal tested each bit with the font pointer reloaded and the bank chosen by a case statement,
+  for every one of the 32 bytes; here a font row is shifted out two bits at a time. Same bytes, same
+  memory (QUIRK 0709:047B is a matter of names only, the writes are these). }
+procedure DrawTandyGlyph(Col, Row, Color, Index: Byte); assembler;
+asm
+  mov   al, Row
+  xor   ah, ah
+  mov   cl, 6
+  shl   ax, cl                 { Row * 64 }
+  mov   di, ax
+  mov   ah, Row
+  xor   al, al                 { Row * 256 }
+  add   di, ax                 { Row * 320: two 160-byte lines of each bank per text row }
+  mov   al, Col
+  xor   ah, ah
+  shl   ax, 1
+  shl   ax, 1
+  add   di, ax                 { + Col * 4 }
+  mov   ah, Color
+  mov   cl, 4
+  shl   ah, cl
+  or    ah, Color              { Color in both nibbles }
+  mov   bl, Index
+  xor   bh, bh
+  shl   bx, 1
+  shl   bx, 1
+  shl   bx, 1
+  mov   cx, $B800
+  mov   es, cx
+  push  ds
+  lds   si, GameFont
+  add   si, bx                 { DS:SI = the glyph's 8 font rows }
+  cld
+  mov   dh, 2                  { two lines of each bank }
+@Line:
+  mov   ch, 4                  { banks 0..3 }
+@Bank:
+  lodsb
+  mov   dl, al                 { the font row: bits 7..0, pixels left to right }
+  mov   cl, 4                  { four bytes, two pixels each }
+@Pair:
+  shl   dl, 1
+  sbb   al, al
+  and   al, $F0                { left pixel: the high nibble }
+  shl   dl, 1
+  sbb   bl, bl
+  and   bl, $0F                { right pixel: the low nibble }
+  or    al, bl
+  and   al, ah
+  stosb
+  dec   cl
+  jnz   @Pair
+  add   di, $2000 - 4          { the same column of the next bank }
+  dec   ch
+  jnz   @Bank
+  sub   di, 4 * $2000 - 160    { bank 0, next line }
+  dec   dh
+  jnz   @Line
+  pop   ds
+end;
+
 { 0709:01DF. Draws Count copies of the GameFont glyph Glyph from cell Col rightwards on
   text row Row in Color, one per outer iteration (Col advances). TextSet nonzero cooks Glyph
   through UpCase into the 64-glyph text set (mod 64), else the raw byte indexes the font.
