+{ ports/dos speed patch (tandy-fill): FillChar with word stores. The same bytes, the direction flag left clear;
+  FillChar of the Turbo Pascal 6.0 runtime stores one byte at a time (0AF8:16B7 REP STOSB). }
+procedure FastFill(var X; Count: Word; Value: Byte); assembler;
+asm
+  cld
+  les   di, X
+  mov   cx, Count
+  mov   al, Value
+  mov   ah, al
+  shr   cx, 1
+  rep   stosw
+  adc   cx, cx
+  rep   stosb
+end;
+{ ports/dos speed patch (tandy-fill): FlushPictureChanges' Tandy branch in the built-in assembler. For each of the
+  168 rows marked in RowDirtyFlags, the bytes RowFirstChangedOfs[Row]..RowLastChangedOfs[Row] of DrawBuf^.Data
+  go to TandyScanlineSegments[Row + 8] at byte column RowFirstChangedCol[Row] + 4 (the Pascal's Move, which
+  copies a byte at a time and runs backwards when the source offset is the lower; DrawBuf is on the heap and the
+  screen is not, so a forward copy by words writes the same bytes). }
+procedure TandyFlushRows; assembler;
+asm
+  cld
+  xor   bx, bx                 { Row }
+@Row:
+  cmp   byte ptr RowDirtyFlags[bx], 0
+  je    @Next
+  push  bx
+  shl   bx, 1
+  mov   si, word ptr RowFirstChangedOfs[bx]
+  mov   cx, word ptr RowLastChangedOfs[bx]
+  sub   cx, si
+  inc   cx
+  mov   di, word ptr RowFirstChangedCol[bx]
+  add   di, 4
+  mov   es, word ptr TandyScanlineSegments[bx+16]
+  push  ds
+  lds   ax, DrawBuf
+  add   si, ax
+  add   si, $17
+  shr   cx, 1
+  rep   movsw
+  adc   cx, cx
+  rep   movsb
+  pop   ds
+  pop   bx
+@Next:
+  inc   bx
+  cmp   bx, $A7
+  jbe   @Row
+end;
