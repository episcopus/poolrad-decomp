+{ ports/dos speed patch (tandy-fill): the Tandy clear of ClearRect and ClearWindow (res09), in the built-in
+  assembler. For each graphics row TopCode..BottomCode (a Word loop: none when TopCode is above BottomCode), Width
+  bytes from byte column LeftCode of that row (Row * 160 + LeftCode) are set to 0 in each of the four banks $B800,
+  $BA00, $BC00, $BE00. The Pascal called FillChar four times a row, which stores one byte at a time; here the same
+  bytes are stored a word at a time. The direction flag is left clear, as FillChar leaves it. }
+procedure TandyClearRows(TopCode, BottomCode, LeftCode, Width: Word); assembler;
+asm
+  cld
+  mov   si, TopCode
+  cmp   si, BottomCode
+  ja    @Done
+  mov   ax, si
+  mov   bx, 160
+  mul   bx
+  add   ax, LeftCode
+  mov   dx, ax                 { the row's first byte in each bank: Row * 160 + LeftCode, by 160 a row }
+@Row:
+  mov   bx, $B800
+@Bank:
+  mov   es, bx
+  mov   di, dx
+  mov   cx, Width
+  xor   ax, ax
+  shr   cx, 1
+  rep   stosw
+  adc   cx, cx
+  rep   stosb
+  add   bx, $200
+  cmp   bx, $C000
+  jb    @Bank
+  cmp   si, BottomCode
+  je    @Done
+  inc   si
+  add   dx, 160
+  jmp   @Row
+@Done:
+end;
