+{ ports/dos speed patch (tandy-pictures): MirrorPicture's Tandy branch for one buffer, in the built-in assembler:
+  Rows rows of RowBytes bytes, each row reversed and each byte's two pixels swapped (SwapNibbles, a rotate by 4).
+  Byte by byte from the start of Dest, the order the Pascal wrote them, so a picture mirrored onto itself comes out
+  the same too. The Pascal did the data and the pixel mask in one loop, a byte of each in turn; they are separate
+  blocks, so mirroring the data and then the mask writes the same bytes. }
+procedure TandyMirrorRows(Source, Dest: Pointer; Rows, RowBytes: Word); assembler;
+asm
+  cld                          { (the game does not always leave the direction flag clear) }
+  push  ds
+  lds   si, Source
+  les   di, Dest
+  mov   bx, si                 { the source row }
+  mov   dx, Rows
+  or    dx, dx
+  jz    @Done
+@Row:
+  mov   cx, RowBytes
+  jcxz  @NextRow
+  mov   si, bx
+  add   si, cx
+  dec   si                     { the row's last byte }
+@Byte:
+  mov   al, [si]
+  dec   si
+  rol   al, 1
+  rol   al, 1
+  rol   al, 1
+  rol   al, 1
+  stosb
+  loop  @Byte
+@NextRow:
+  add   bx, RowBytes
+  dec   dx
+  jnz   @Row
+@Done:
+  pop   ds
+end;
