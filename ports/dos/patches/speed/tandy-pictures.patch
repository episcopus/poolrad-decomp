+{ ports/dos speed patch (tandy-pictures): the Tandy branch of UnpackPicturePixels for one item, in the built-in
+  assembler: for each of Count bytes of Data (two 4-bit pixels) the mask byte at Pixels becomes $F0 where the left
+  pixel is Color and gains $0F where the right one is, and the data byte loses the masked bits (the Pascal's three
+  statements in order, reading the data byte before it is changed). The caller keeps the Pascal loop for an empty
+  item or one that would wrap the offset. }
+procedure TandyColorMask(Data, Pixels: Pointer; Count: Word; Color: Byte); assembler;
+asm
+  push  ds
+  les   di, Pixels
+  lds   si, Data
+  mov   cx, Count
+  mov   bl, Color
+@Byte:
+  mov   al, [si]
+  mov   ah, al
+  shr   ah, 1
+  shr   ah, 1
+  shr   ah, 1
+  shr   ah, 1
+  cmp   ah, bl
+  jne   @Right
+  mov   byte ptr es:[di], $F0
+@Right:
+  mov   ah, al
+  and   ah, $0F
+  cmp   ah, bl
+  jne   @Clear
+  add   byte ptr es:[di], $0F
+@Clear:
+  mov   ah, es:[di]
+  not   ah
+  and   al, ah
+  mov   [si], al
+  inc   si
+  inc   di
+  loop  @Byte
+  pop   ds
 end;
